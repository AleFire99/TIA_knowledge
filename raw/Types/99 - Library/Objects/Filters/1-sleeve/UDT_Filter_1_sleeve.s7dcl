            { S7_MLC := "MLC_33a" }
            manual : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_3Td"
            }
            auto : Bool;
        END_STRUCT;
        SETTING : STRUCT
            { S7_MLC := "MLC_3HH" }
            pulse_duration : Time := T#500ms;
            { S7_MLC := "MLC_3Yd" }
            interval_duration : Time := T#3s;
        END_STRUCT;
        { S7_Access := "ReadOnly := External" }
        STATUS : STRUCT
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_Vy"
            }
            state : Int := 1;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_X4"
            }
