            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_ZQ"
            }
            is_active : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_5Bx"
            }
            is_pulsing : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_3VK"
            }
