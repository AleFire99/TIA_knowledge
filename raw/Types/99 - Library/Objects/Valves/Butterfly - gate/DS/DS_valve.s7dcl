{
    S7_EditorMode := "SCL";
    S7_GenerateENOforSCL := "TRUE";
    S7_IECCheck := "TRUE";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "DS_valve"
    VAR_IN_OUT
        XV : _.UDT_DS_Valve;
    END_VAR
    VAR
        {
            S7_Access := "ReadOnly := External";
            S7_MLC := "MLC_3pQ";
            S7_Visibility := "Hidden := External"
        }
        first_scan : Bool := TRUE;
        {
            S7_Access := "ReadOnly := External";
            S7_MLC := "MLC_3EU";
            S7_Visibility := "Hidden := External"
        }
        movement_timer : TON_TIME;
        {
            S7_Access := "ReadOnly := External";
            S7_Visibility := "Hidden := External"
        }
        fb_XYA : _.Solenoid_valve;
        {
            S7_Access := "ReadOnly := External";
            S7_Visibility := "Hidden := External"
        }
        fb_XYB : _.Solenoid_valve;
    END_VAR
    VAR_TEMP
        { S7_MLC := "MLC_3Tk" }
        desired_command : Bool;
        internal_error : Bool;
    END_VAR
    VAR CONSTANT
        { S7_MLC := "MLC_4zW" }
        FAULT : Int := 0;
        { S7_MLC := "MLC_3d7" }
        NORMAL : Int := 1;
        { S7_MLC := "MLC_3Nb" }
        CLOSED : Int := 1;
        { S7_MLC := "MLC_Zz" }
        OPENING : Int := 2;
        { S7_MLC := "MLC_3ZN" }
        OPEN : Int := 3;
        { S7_MLC := "MLC_kL" }
        CLOSING : Int := 4;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Map internal valves
            #fb_XYA(#XV.DEVICES.XYA);
            #fb_XYB(#XV.DEVICES.XYB);
        END_REGION
        
        REGION Determine desired target
            IF #XV.CORE.CMD.manual_mode THEN
                #desired_command := #XV.CORE.CMD.manual;
            ELSE
                #desired_command := #XV.CORE.CMD.auto;
            END_IF;
        END_REGION
        
        REGION Initialization
            IF #first_scan THEN
                #first_scan := FALSE;
                IF #XV.DEVICES.ZSL AND #XV.DEVICES.ZSH THEN
                    #XV.CORE.STATUS.state := #FAULT;
                ELSE
                    IF #XV.DEVICES.ZSL AND NOT #XV.DEVICES.ZSH THEN
                        #XV.CORE.STATUS.state := #NORMAL;
                        #XV.CORE.STATUS.normal_state := #CLOSED;
                    ELSIF #XV.DEVICES.ZSH AND NOT #XV.DEVICES.ZSL THEN
                        #XV.CORE.STATUS.state := #NORMAL;
                        #XV.CORE.STATUS.normal_state := #OPEN;
                    ELSIF NOT #XV.DEVICES.ZSL AND NOT #XV.DEVICES.ZSH AND #desired_command THEN
                        #XV.CORE.STATUS.state := #NORMAL;
                        #XV.CORE.STATUS.normal_state := #OPENING;
                    ELSIF NOT #XV.DEVICES.ZSL AND NOT #XV.DEVICES.ZSH AND NOT #desired_command THEN
                        #XV.CORE.STATUS.state := #NORMAL;
                        #XV.CORE.STATUS.normal_state := #CLOSING;
                    END_IF;
                END_IF;
            END_IF;
        END_REGION
        
        REGION Movement timer
            #movement_timer(
                            IN := (#XV.CORE.STATUS.state = #NORMAL AND
                            (#XV.CORE.STATUS.normal_state = #OPENING OR #XV.CORE.STATUS.normal_state = #CLOSING)),
                            PT := #XV.CORE.SETTING.actuator_timeout);
        END_REGION
        
        REGION Alarms
            IF (#XV.CORE.STATUS.state = #NORMAL AND #XV.CORE.STATUS.normal_state = #CLOSED AND NOT #XV.DEVICES.ZSL) OR
                (#XV.CORE.STATUS.state = #NORMAL AND #XV.CORE.STATUS.normal_state = #OPEN AND NOT #XV.DEVICES.ZSH) THEN
                #XV.ALARMS.sensor_mismatch := TRUE;
            END_IF;
            
            IF #XV.DEVICES.ZSL AND #XV.DEVICES.ZSH THEN
                #XV.ALARMS.sensor_conflict := TRUE;
            END_IF;
            
            IF #movement_timer.Q THEN
                IF #XV.CORE.STATUS.normal_state = #CLOSING THEN
                    #XV.ALARMS.failed_to_close := TRUE;
                ELSIF #XV.CORE.STATUS.normal_state = #OPENING THEN
                    #XV.ALARMS.failed_to_open := TRUE;
                END_IF;
            END_IF;
        END_REGION
        
        REGION Acknowledgment
            IF #XV.CORE.CMD.ack THEN
                #XV.ALARMS.sensor_mismatch := FALSE;
                #XV.ALARMS.sensor_conflict := FALSE;
                #XV.ALARMS.failed_to_close := FALSE;
                #XV.ALARMS.failed_to_open := FALSE;
            END_IF;
        END_REGION
        
        REGION Internal error
            #internal_error := #XV.ALARMS.sensor_mismatch
            OR #XV.ALARMS.sensor_conflict
            OR #XV.ALARMS.failed_to_close
            OR #XV.ALARMS.failed_to_open;
        END_REGION
        
        REGION Top FSM
            CASE #XV.CORE.STATUS.state OF
                #NORMAL:
                    IF #internal_error THEN
                        #XV.CORE.STATUS.state := #FAULT;
                    END_IF;
                    
                #FAULT:
                    IF #XV.CORE.CMD.ack AND NOT #internal_error THEN
                        IF #XV.DEVICES.ZSL AND NOT #XV.DEVICES.ZSH THEN
                            #XV.CORE.STATUS.state := #NORMAL;
                            #XV.CORE.STATUS.normal_state := #CLOSED;
                        ELSIF #XV.DEVICES.ZSH AND NOT #XV.DEVICES.ZSL THEN
                            #XV.CORE.STATUS.state := #NORMAL;
                            #XV.CORE.STATUS.normal_state := #OPEN;
                        ELSIF NOT #XV.DEVICES.ZSH AND NOT #XV.DEVICES.ZSL AND #desired_command THEN
                            #XV.CORE.STATUS.state := #NORMAL;
                            #XV.CORE.STATUS.normal_state := #OPENING;
                        ELSIF NOT #XV.DEVICES.ZSH AND NOT #XV.DEVICES.ZSL AND NOT #desired_command THEN
                            #XV.CORE.STATUS.state := #NORMAL;
                            #XV.CORE.STATUS.normal_state := #CLOSING;
                        END_IF;
                    END_IF;
            END_CASE;
        END_REGION
        
        REGION Normal FSM
            IF #XV.CORE.STATUS.state = #NORMAL THEN
                CASE #XV.CORE.STATUS.normal_state OF
                    #CLOSED:
                        IF #desired_command THEN
                            #XV.CORE.STATUS.normal_state := #OPENING;
                        END_IF;
                        
                    #OPENING:
                        IF #XV.DEVICES.ZSH AND NOT #XV.DEVICES.ZSL THEN
                            #XV.CORE.STATUS.normal_state := #OPEN;
                        END_IF;
                        
                    #OPEN:
                        IF NOT #desired_command THEN
                            #XV.CORE.STATUS.normal_state := #CLOSING;
                        END_IF;
                        
                    #CLOSING:
                        IF #XV.DEVICES.ZSL AND NOT #XV.DEVICES.ZSH THEN
                            #XV.CORE.STATUS.normal_state := #CLOSED;
                        END_IF;
                END_CASE;
            END_IF;
        END_REGION
        
        REGION Output mapping
            #XV.DEVICES.XYA.CMD.auto := FALSE;
            #XV.DEVICES.XYB.CMD.auto := FALSE;
            
            IF #XV.CORE.STATUS.state = #NORMAL THEN
                CASE #XV.CORE.STATUS.normal_state OF
                    
                    #OPENING:
                        #XV.DEVICES.XYA.CMD.auto := TRUE;
                        
                    #CLOSING:
                        #XV.DEVICES.XYB.CMD.auto := TRUE;
                END_CASE;
            END_IF;
        END_REGION
        
        REGION State mapping
            #XV.CORE.STATUS.is_closed := (#XV.CORE.STATUS.state = #NORMAL) AND (#XV.CORE.STATUS.normal_state = #CLOSED);
            #XV.CORE.STATUS.is_opening := (#XV.CORE.STATUS.state = #NORMAL) AND (#XV.CORE.STATUS.normal_state = #OPENING);
            #XV.CORE.STATUS.is_open := (#XV.CORE.STATUS.state = #NORMAL) AND (#XV.CORE.STATUS.normal_state = #OPEN);
            #XV.CORE.STATUS.is_closing := (#XV.CORE.STATUS.state = #NORMAL) AND (#XV.CORE.STATUS.normal_state = #CLOSING);
            #XV.CORE.STATUS.is_fault := (#XV.CORE.STATUS.state = #FAULT);
        END_REGION
    END_NETWORK
END_FUNCTION_BLOCK
