{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "Gate_door"
    VAR_IN_OUT 
        gate_door : _.UDT_Gate_Door;
    END_VAR
    VAR 
        {
            S7_Access := "ReadOnly := External";
            S7_Visibility := "Hidden := External"
        }
        first_scan : Bool := TRUE;
        {
            S7_Access := "ReadOnly := External";
            S7_Visibility := "Hidden := External"
        }
        fb_XY : _.Solenoid_valve;
    END_VAR
    VAR CONSTANT 
        CLOSED : Int := 1;
        OPENING : Int := 2;
        OPEN : Int := 3;
        CLOSING : Int := 4;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Initialization
          // On first scan, determine state from physical sensors
          IF #first_scan THEN
            #first_scan := FALSE;
            IF #gate_door.DEVICES.ZSL THEN
              #gate_door.STATUS.state := #CLOSED;
            ELSE
              #gate_door.STATUS.state := #OPEN;
            END_IF;
          END_IF;
        END_REGION
        
        REGION Map internal valves
          #fb_XY(#gate_door.DEVICES.XY);
        END_REGION
        
        REGION FSM logic
          // Moore machine: transitions driven by inputs, outputs assigned in Output mapping region
          CASE #gate_door.STATUS.state OF
              
            #CLOSED:
              IF #gate_door.CMD.open AND NOT #gate_door.CMD.interlocked THEN
                // Guard is active-low: interlocked = FALSE means orchestrator permits opening
                #gate_door.STATUS.state := #OPENING;
              END_IF;
              
            #OPENING:
              IF NOT #gate_door.DEVICES.ZSL THEN
                #gate_door.STATUS.state := #OPEN;
              END_IF;
              
            #OPEN:
              IF #gate_door.CMD.close THEN
                #gate_door.STATUS.state := #CLOSING;
              END_IF;
              
            #CLOSING:
              IF #gate_door.DEVICES.ZSL THEN
                #gate_door.STATUS.state := #CLOSED;
              END_IF;
              
          END_CASE;
        END_REGION
        
        REGION Output mapping
          #gate_door.DEVICES.XY.CMD.auto := FALSE;
          #gate_door.STATUS.is_closed := FALSE;
          #gate_door.STATUS.is_opening := FALSE;
          #gate_door.STATUS.is_open := FALSE;
          #gate_door.STATUS.is_closing := FALSE;
          
          CASE #gate_door.STATUS.state OF
            #CLOSED:
              #gate_door.STATUS.is_closed := TRUE;
              
            #OPENING:
              #gate_door.DEVICES.XY.CMD.auto := TRUE;
              #gate_door.STATUS.is_opening := TRUE;
              
            #OPEN:
              #gate_door.DEVICES.XY.CMD.auto := TRUE;
              #gate_door.STATUS.is_open := TRUE;
              
            #CLOSING:
              #gate_door.STATUS.is_closing := TRUE;
          END_CASE;
        END_REGION
    END_NETWORK
END_FUNCTION_BLOCK
