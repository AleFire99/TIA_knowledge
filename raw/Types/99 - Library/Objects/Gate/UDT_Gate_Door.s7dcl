TYPE
    UDT_Gate_Door : STRUCT
        { S7_Access := "ReadOnly := External" }
        DEVICES : STRUCT
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_4hJ"
            }
            ZSL : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_56T"
            }
            XY : _.UDT_Solenoid_valve;
        END_STRUCT;
        CMD : STRUCT
            { S7_MLC := "MLC_3Lb" }
            open : Bool;
            { S7_MLC := "MLC_4dL" }
            close : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_4um"
            }
            interlocked : Bool;
        END_STRUCT;
        SETTING : STRUCT
            { S7_MLC := "MLC_3Ya" }
            door_timeout : Time := T#3M;
        END_STRUCT;
        { S7_Access := "ReadOnly := External" }
        STATUS : STRUCT
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_4xE"
            }
            state : Int := 1;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_Qy"
            }
            is_closed : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_4iB"
            }
            is_opening : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_4Tg"
            }
            is_open : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_Ly"
            }
            is_closing : Bool;
        END_STRUCT;
    END_STRUCT;
END_TYPE
