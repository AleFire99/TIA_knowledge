    en-US: SETTING - Vessel pressure threshold to consider empty (barg)
  - id: MLC_3BL
    en-US: SETTING - Line pressure threshold to consider empty (barg)
  - id: MLC_4x9
    en-US: SETTING - Vessel overpressure required before opening line valve (barg)
  - id: MLC_SG
    en-US: SETTING - Internal valves timeout setting
  - id: MLC_3CB
    en-US: SETTING - Timeout timer for pressurization phase
  - id: MLC_Xb
    en-US: SETTING - Timeout timer for depressurization phase
  - id: MLC_56C
    en-US: STATE - 0=fault, 1=normal
  - id: MLC_4tP
    en-US: STATE - 10=idle, 20=filling, 30=sealing, 40=pressurizing, 50=conveying, 60=depressurizing
  - id: MLC_589
    en-US: STATUS - Transporter idle
  - id: MLC_3mQ
    en-US: STATUS - Vessel being filled
