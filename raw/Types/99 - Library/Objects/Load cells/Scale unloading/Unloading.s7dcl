{
    S7_BlockComment := "MLC_35M";
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "Unloading"
    VAR_IN_OUT
        scale : _.UDT_Load_cells;
    END_VAR
    VAR
        {
            S7_Access := "ReadOnly := External";
            S7_Visibility := "Hidden := External"
        }
        prev_state : Int := 1;
        {
            S7_Access := "ReadOnly := External";
            S7_Visibility := "Hidden := External"
        }
        last_checked_weight : Real;
        {
            S7_Access := "ReadOnly := External";
            S7_MLC := "MLC_3fF";
            S7_Visibility := "Hidden := External"
        }
        stall_timer : TON_TIME;
    END_VAR
    VAR_TEMP
        internal_error : Bool;
    END_VAR
    VAR CONSTANT
        FAULT : Int := 0;
        { S7_MLC := "MLC_5AQ" }
        IDLE : Int := 1;
        { S7_MLC := "MLC_4KT" }
        UNLOADING : Int := 2;
        { S7_MLC := "MLC_b5" }
        PAUSED : Int := 3;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Stall detection
            // "Progress" = weight has dropped by at least stalled_threshold since we last checked.
            // Every time progress is detected we re-anchor the reference weight, which drops the
            // timer's IN for one scan and resets it to zero — so the timer only ever measures the
            // time since the *last* significant drop, not total conveying time.
            #stall_timer(IN := (#scale.STATUS.UNLOADING.state = #UNLOADING)
                         AND NOT (#scale.IN.current_weight <= #last_checked_weight - #scale.SETTING.unloading_stalled_treshold),
                         PT := #scale.SETTING.unloading_timeout);
            
            IF (#scale.STATUS.UNLOADING.state = #UNLOADING)
                AND #scale.IN.current_weight <= #last_checked_weight - #scale.SETTING.unloading_stalled_treshold THEN
                #last_checked_weight := #scale.IN.current_weight;
            END_IF;
        END_REGION
        
        REGION Configuration
            #scale.ALARMS.weight_invalid := (#scale.IN.current_weight < #scale.SETTING.min_weight) OR (#scale.IN.current_weight > #scale.SETTING.max_weight);
        END_REGION
        
        REGION Alarms
            #internal_error := #stall_timer.Q OR #scale.IN.scale_error OR #scale.IN.plant_error;
        END_REGION
        
        REGION FSM
            CASE #scale.STATUS.UNLOADING.state OF
                    
                #IDLE:
                    IF #scale.CMD.unloading_start AND NOT #scale.ALARMS.weight_invalid THEN
                        #scale.STATUS.UNLOADING.state := #UNLOADING;
                    END_IF;
                    
                #UNLOADING:
                    IF #internal_error THEN
                        #scale.STATUS.UNLOADING.state := #FAULT;
                    ELSIF #scale.CMD.stop OR (#scale.IN.current_weight <= #scale.SETTING.min_weight) THEN
                        #scale.STATUS.UNLOADING.state := #PAUSED;
                    ELSIF #scale.BATCH.transferred >= #scale.CMD.unloading_setpoint - #scale.SETTING.unloading_tail THEN
                        #scale.STATUS.UNLOADING.state := #IDLE;
                    END_IF;
                    
                #PAUSED:
                    IF #scale.CMD.unloading_start THEN
                        #scale.STATUS.UNLOADING.state := #UNLOADING;
                    ELSIF #scale.CMD.reset THEN
                        #scale.STATUS.UNLOADING.state := #IDLE;
                    END_IF;
                    
                #FAULT:
                    IF #scale.CMD.ack THEN
                        #scale.STATUS.UNLOADING.state := #PAUSED;
                    END_IF;
                    
            END_CASE;
        END_REGION
        
        REGION Entry actions
            #scale.STATUS.UNLOADING.unloading_finished := FALSE;
            
            IF #scale.STATUS.UNLOADING.state <> #prev_state THEN
                
                CASE #scale.STATUS.UNLOADING.state OF
                        
                    #IDLE:
                        #scale.BATCH.transferred := 0.0;
                        #scale.STATUS.UNLOADING.unloading_finished := TRUE;
                        
                    #UNLOADING:
                        // On first start: conveyed = 0.0, so weight_at_start = current_weight (normal snapshot).
                        // On resume: conveyed holds the frozen value, so we back-calculate the anchor such that (weight_at_start - current_weight) = previous conveyed immediately.
                        #scale.BATCH.weight_at_start := #scale.IN.current_weight + #scale.BATCH.transferred;
                        // Re-anchor the stall watchdog too, so a value left over from a previous
                        // run/pause can't be mistaken for "no progress" the instant we (re)start.
                        #last_checked_weight := #scale.IN.current_weight;
                        
                END_CASE;
                
                #prev_state := #scale.STATUS.UNLOADING.state;
            END_IF;
        END_REGION
        
        REGION Conveyed quantity
            // Computed every scan. Only meaningful during CONVEYING.
            // Clamped to zero to avoid negative display on sensor drift.
            // PAUSED / ERROR: no assignment — holds last frozen value.
            IF #scale.STATUS.UNLOADING.state = #UNLOADING THEN
                #scale.BATCH.transferred := #scale.BATCH.weight_at_start - #scale.IN.current_weight;
                IF #scale.BATCH.transferred < 0.0 THEN
                    #scale.BATCH.transferred := 0.0;
                END_IF;
            END_IF;
        END_REGION
        
        REGION Mapped states
            // Moore outputs — derived purely from state, reset each scan.
            #scale.STATUS.UNLOADING.is_idle := (#scale.STATUS.UNLOADING.state = #IDLE);
            #scale.STATUS.UNLOADING.is_unloading := (#scale.STATUS.UNLOADING.state = #UNLOADING);
            #scale.STATUS.UNLOADING.is_paused := (#scale.STATUS.UNLOADING.state = #PAUSED);
            #scale.STATUS.UNLOADING.is_fault := (#scale.STATUS.UNLOADING.state = #FAULT);
        END_REGION
        
        REGION Alarms mapping
            #scale.ALARMS.unloading_timeout := #internal_error;
        END_REGION
    END_NETWORK
END_FUNCTION_BLOCK
