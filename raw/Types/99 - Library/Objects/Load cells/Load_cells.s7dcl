{
    S7_BlockComment := "MLC_35M";
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "Load_cells"
    VAR_IN_OUT 
        scale : _.UDT_Load_cells;
    END_VAR
    VAR 
        {
            S7_Access := "ReadOnly := External";
            S7_MLC := "MLC_3fF";
            S7_Visibility := "Hidden := External"
        }
        transport_timer : TON_TIME;
    END_VAR
    VAR CONSTANT 
        { S7_MLC := "MLC_5AQ" }
        IDLE : Int := 1;
        { S7_MLC := "MLC_Ue" }
        SNAPSHOT : Int := 2;
        { S7_MLC := "MLC_4KT" }
        CONVEYING : Int := 3;
        { S7_MLC := "MLC_b5" }
        PAUSED : Int := 4;
        FINISHED : Int := 5;
        TIMEOUT : Int := 0;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Timeout timer
          #transport_timer(IN := (#scale.STATUS.state = #CONVEYING),
                           PT := #scale.SETTING.conveying_timeout);
        END_REGION
        
        REGION Configuration
          #scale.ALARMS.weight_invalid := (#scale.IN.current_weight < #scale.SETTING.weight_min)
          OR (#scale.IN.current_weight > #scale.SETTING.weight_max);
          
          #scale.ALARMS.setpoint_invalid := (#scale.CMD.setpoint <= 0);
          
          #scale.BATCH.configured := (NOT #scale.ALARMS.weight_invalid) AND (NOT #scale.ALARMS.setpoint_invalid);
        END_REGION
        
        REGION FSM
          CASE #scale.STATUS.state OF
              
            #IDLE:
              #scale.BATCH.conveyed := 0.0;
              IF #scale.CMD.start AND #scale.BATCH.configured THEN
                #scale.STATUS.state := #SNAPSHOT;
              END_IF;
              
            #SNAPSHOT:
              // On first start:  conveyed = 0.0, so weight_at_start = current_weight (normal snapshot)
              // On resume:       conveyed holds frozen value, so we back-calculate the effective anchor
              //                  such that (weight_at_start - current_weight) = previous conveyed immediately
              #scale.BATCH.weight_at_start := #scale.IN.current_weight + #scale.BATCH.conveyed;
              #scale.STATUS.state := #CONVEYING;
              
            #CONVEYING:
              IF #transport_timer.Q THEN
                #scale.STATUS.state := #TIMEOUT;
              ELSIF #scale.CMD.stop OR (#scale.IN.current_weight <= #scale.SETTING.weight_min) OR #scale.IN.plant_error THEN
                #scale.STATUS.state := #PAUSED;
              ELSIF #scale.BATCH.conveyed >= #scale.CMD.setpoint - #scale.SETTING.batch_tail THEN
                #scale.STATUS.state := #FINISHED;
              END_IF;
              
            #PAUSED:
              IF #scale.CMD.start THEN
                #scale.STATUS.state := #SNAPSHOT;
              ELSIF #scale.CMD.reset THEN
                #scale.STATUS.state := #IDLE;
              END_IF;
              
            #FINISHED:
              #scale.STATUS.state := #IDLE;
              
            #TIMEOUT:
              IF #scale.CMD.ack THEN
                #scale.STATUS.state := #PAUSED;
              END_IF;
              
          END_CASE;
        END_REGION
        
        REGION Conveyed quantity
          // Computed every scan. Only meaningful during CONVEYING.
          // Clamped to zero to avoid negative display on sensor drift.
          // PAUSED / TIMEOUT / FINISHED: no assignment — holds last frozen value.
          IF #scale.STATUS.state = #CONVEYING THEN
            #scale.BATCH.conveyed := #scale.BATCH.weight_at_start - #scale.IN.current_weight;
            IF #scale.BATCH.conveyed < 0.0 THEN
              #scale.BATCH.conveyed := 0.0;
            END_IF;
          END_IF;
        END_REGION
        
        REGION Mapped outputs
          // Moore outputs — derived purely from state, reset each scan.
          #scale.STATUS.is_conveying := (#scale.STATUS.state = #CONVEYING);
          #scale.STATUS.is_idle := (#scale.STATUS.state = #IDLE);
          #scale.STATUS.is_paused := (#scale.STATUS.state = #PAUSED);
          #scale.STATUS.is_finished := (#scale.STATUS.state = #FINISHED);
          #scale.ALARMS.transport_timeout := (#scale.STATUS.state = #TIMEOUT);
        END_REGION
    END_NETWORK
END_FUNCTION_BLOCK
