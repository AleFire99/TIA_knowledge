{
    S7_BlockComment := "MLC_35M";
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "Load_cells"
    VAR_IN_OUT 
        scale : _.UDT_Load_cells;
    END_VAR
    VAR 
        {
            S7_Access := "ReadOnly := External";
            S7_MLC := "MLC_3fF";
            S7_Visibility := "Hidden := External"
        }
        transport_timer : TON_TIME;
    END_VAR
    VAR CONSTANT 
        NORMAL : Int := 1;
        { S7_MLC := "MLC_4sw" }
        ERROR : Int := 0;
        { S7_MLC := "MLC_5AQ" }
        IDLE : Int := 1;
        { S7_MLC := "MLC_Ue" }
        SNAPSHOT : Int := 2;
        { S7_MLC := "MLC_4KT" }
        TRANSPORTING : Int := 3;
        { S7_MLC := "MLC_b5" }
        INCOMPLETE : Int := 0;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        REGION Timeout timer
            // Timer runs only in RUNNING state, preset comes from operator-configurable setting
            #transport_timer(IN := (#scale.STATUS.normal_state = #TRANSPORTING),
                             PT := #scale.SETTING.timeout_pt);
        END_REGION
        
        REGION Configuration
            #scale.ALARMS.weight_invalid := (#scale.IN.current_weight < #scale.SETTING.weight_min)
            OR (#scale.IN.current_weight > #scale.SETTING.weight_max);
            
            #scale.ALARMS.setpoint_invalid := (#scale.CMD.setpoint <= 0)
            OR (#scale.CMD.setpoint >= #scale.IN.current_weight);
            
            #scale.BATCH.configured := (NOT #scale.ALARMS.weight_invalid) AND (NOT #scale.ALARMS.setpoint_invalid);
        END_REGION
        
        REGION Top FSM logic
            CASE #scale.STATUS.state OF
                    
                #NORMAL:
                    IF #scale.STATUS.is_in_error THEN
                        #scale.STATUS.state := #ERROR;
                    END_IF;
                    
                #ERROR:
                    IF #scale.CMD.ack THEN
                        #scale.STATUS.state := #NORMAL;
                        #scale.STATUS.normal_state := #IDLE;
                    END_IF;
            END_CASE;
        END_REGION
        
        REGION Normal behaviour FSM
            IF #scale.STATUS.state = #NORMAL THEN
                CASE #scale.STATUS.normal_state OF
                    #IDLE:
                        IF #scale.CMD.plant_start AND #scale.BATCH.configured THEN
                            #scale.STATUS.normal_state := #SNAPSHOT;
                        END_IF;
                        
                    #SNAPSHOT:
                        #scale.BATCH.weight_at_start := #scale.IN.current_weight;
                        #scale.STATUS.normal_state := #TRANSPORTING;
                        
                    #TRANSPORTING:
                        IF #transport_timer.Q THEN
                            #scale.STATUS.normal_state := #INCOMPLETE;
                        ELSIF #scale.BATCH.conveyed >= #scale.CMD.setpoint
                            OR #scale.CMD.plant_stop THEN
                            #scale.STATUS.normal_state := #IDLE;
                        END_IF;
                        
                    #INCOMPLETE:
                        IF #scale.CMD.ack THEN
                            #scale.STATUS.normal_state := #IDLE;
                        END_IF;
                        
                END_CASE;
            END_IF;
        END_REGION
        
        REGION Conveyed quantity
            // Computed every scan. Only meaningful during TRANSPORTING.
            // Clamped to zero to avoid negative display on sensor drift.
            IF #scale.STATUS.normal_state = #TRANSPORTING THEN
                #scale.BATCH.conveyed := #scale.BATCH.weight_at_start - #scale.IN.current_weight;
                IF #scale.BATCH.conveyed < 0.0 THEN
                    #scale.BATCH.conveyed := 0.0;
                END_IF;
            ELSE
                #scale.BATCH.conveyed := 0.0;
            END_IF;
        END_REGION
        
        REGION Mapped outputs
            // Moore outputs — derived purely from state, reset each scan.
            #scale.STATUS.is_transporting := (#scale.STATUS.state = #NORMAL) AND (#scale.STATUS.normal_state = #TRANSPORTING);
            #scale.STATUS.is_idle := (#scale.STATUS.state = #NORMAL) AND (#scale.STATUS.normal_state = #IDLE);
            #scale.STATUS.is_incomplete := (#scale.STATUS.state = #NORMAL) AND (#scale.STATUS.normal_state = #INCOMPLETE);
            #scale.STATUS.is_in_error := (#scale.STATUS.state = #ERROR);
        END_REGION
        
    END_NETWORK
END_FUNCTION_BLOCK
