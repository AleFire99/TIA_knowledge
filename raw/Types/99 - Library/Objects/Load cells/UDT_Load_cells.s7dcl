TYPE
    { S7_BlockComment := "MLC_fN" }
    UDT_Load_cells : STRUCT
        CMD : STRUCT
            { S7_MLC := "MLC_gs" }
            ack : Bool;
            loading_setpoint : Real;
            { S7_MLC := "MLC_3JK" }
            unloading_setpoint : Real;
            { S7_MLC := "MLC_xz" }
            tare_request : Bool;
            loading_start : Bool;
            { S7_MLC := "MLC_3aM" }
            unloading_start : Bool;
            { S7_MLC := "MLC_3uX" }
            stop : Bool;
            reset : Bool;
        END_STRUCT;
        { S7_Access := "ReadOnly := External" }
        IN : STRUCT
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_4jG"
            }
            current_weight : Real;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_NA"
            }
            scale_error : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_3sc"
            }
            plant_error : Bool;
        END_STRUCT;
        SETTING : STRUCT
            min_weight : Real := 0.0;
            { S7_MLC := "MLC_4BM" }
            max_weight : Real := 1000.0;
            loading_tail : Real;
            { S7_MLC := "MLC_54D" }
            unloading_tail : Real;
            loading_timeout : Time := T#10M;
            { S7_MLC := "MLC_4uy" }
            unloading_timeout : Time := T#10M;
        END_STRUCT;
        { S7_Access := "ReadOnly := External" }
        STATUS : STRUCT
            { S7_Access := "ReadOnly := External" }
            LOADING : STRUCT
                { S7_Access := "ReadOnly := External" }
                state : Int := 1;
                { S7_Access := "ReadOnly := External" }
                is_idle : Bool;
                { S7_Access := "ReadOnly := External" }
                is_loading : Bool;
                { S7_Access := "ReadOnly := External" }
                loading_finished : Bool;
            END_STRUCT;
            { S7_Access := "ReadOnly := External" }
            UNLOADING : STRUCT
                {
                    S7_Access := "ReadOnly := External";
                    S7_MLC := "MLC_4Zk"
                }
                state : Int := 1;
                {
                    S7_Access := "ReadOnly := External";
                    S7_MLC := "MLC_3NK"
                }
                is_idle : Bool;
                {
                    S7_Access := "ReadOnly := External";
                    S7_MLC := "MLC_3zQ"
                }
                is_unloading : Bool;
                {
                    S7_Access := "ReadOnly := External";
                    S7_MLC := "MLC_4PX"
                }
                is_paused : Bool;
                { S7_Access := "ReadOnly := External" }
                unloading_finished : Bool;
            END_STRUCT;
        END_STRUCT;
        { S7_Access := "ReadOnly := External" }
        BATCH : STRUCT
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_XT"
            }
            transferred : Real;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_3Ss"
            }
            weight_at_start : Real;
        END_STRUCT;
        { S7_Access := "ReadOnly := External" }
        ALARMS : STRUCT
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_4LS"
            }
            weight_invalid : Bool;
            { S7_Access := "ReadOnly := External" }
            loading_timeout : Bool;
            { S7_Access := "ReadOnly := External" }
            unloading_timeout : Bool;
        END_STRUCT;
    END_STRUCT;
END_TYPE
