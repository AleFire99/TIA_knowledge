TYPE
    UDT_Pinch_diverter : STRUCT
        { S7_Access := "ReadOnly := External" }
        DEVICES : STRUCT
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_4Kd"
            }
            XVA : _.UDT_Pinch_Valve;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_4Hn"
            }
            XVB : _.UDT_Pinch_Valve;
        END_STRUCT;
        CMD : STRUCT
            { S7_MLC := "MLC_4nb" }
            manual_mode : Bool;
            { S7_MLC := "MLC_35T" }
            manual : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_3Gt"
            }
            auto : Bool;
            { S7_MLC := "MLC_3rw" }
            ack : Bool;
        END_STRUCT;
        SETTING : STRUCT
            { S7_MLC := "MLC_4ZL" }
            actuator_timeout : Time := T#2s;
        END_STRUCT;
        { S7_Access := "ReadOnly := External" }
        STATUS : STRUCT
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_5CJ"
            }
            state : Int := 1;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_4EX"
            }
            normal_state : Int := 1;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_3Cv"
            }
            is_in_A : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_bV"
            }
            is_moving_to_B : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_3dB"
            }
            is_in_B : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_4AD"
            }
            is_moving_to_A : Bool;
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_4fF"
            }
            is_fault : Bool;
        END_STRUCT;
        { S7_Access := "ReadOnly := External" }
        ALARMS : STRUCT
            {
                S7_Access := "ReadOnly := External";
                S7_MLC := "MLC_3nh"
            }
            valve_mismatch : Bool;
        END_STRUCT;
    END_STRUCT;
END_TYPE
