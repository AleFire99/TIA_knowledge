TYPE "UDT_Gate_Door"
VERSION : 0.1
   STRUCT
      DEVICES { ExternalWritable := 'False'} : Struct
         ZSL { ExternalWritable := 'False'} : Bool;   // INPUT - Pressure received
         XY { ExternalWritable := 'False'; S7_SetPoint := 'False'} : "UDT_Solenoid_valve";   // OUTPUT - Command
      END_STRUCT;
      CMD : Struct
         open : Bool;   // COMMAND - Manual command
         close : Bool;
         interlocked { ExternalWritable := 'False'} : Bool;   // COMMAND - 0=enabled/1=interlocked
      END_STRUCT;
      STATUS { ExternalWritable := 'False'} : Struct
         state { ExternalWritable := 'False'} : Int;   // STATE -  1=ClosedLocked, 2=ClosedUnlocked, 3=Open
         is_closed_locked { ExternalWritable := 'False'} : Bool;   // STATUS - Door is closed and locked
         is_closed_unlocked { ExternalWritable := 'False'} : Bool;   // STATUS - Door is closed but unlocked
         is_open { ExternalWritable := 'False'} : Bool;   // STATUS - Door is open
      END_STRUCT;
   END_STRUCT;

END_TYPE

