TYPE "UDT_Filter_2_sleeves"
VERSION : 0.1
   STRUCT
      DEVICES { ExternalWritable := 'False'} : Struct
         XYA { ExternalWritable := 'False'; S7_SetPoint := 'False'} : "UDT_Solenoid_valve";   // OUTPUT - Solenoid command sleeve A
         XYB { ExternalWritable := 'False'; S7_SetPoint := 'False'} : "UDT_Solenoid_valve";   // OUTPUT - Solenoid command sleeve B
      END_STRUCT;
      CMD : Struct
         manual_mode : Bool;   // COMMAND - Active mode
         manual : Bool;   // COMMAND - Manual command
         auto { ExternalWritable := 'False'} : Bool;   // COMMAND - Automatic command
         interlocked { ExternalWritable := 'False'} : Bool;   // COMMAND - 0=enabled/1=interlocked
      END_STRUCT;
      SETTING : Struct
         pulse_duration : Time := T#500ms;   // SETTING - Duration of active pulse
         interval_duration : Time := T#3s;   // SETTING - Duration of time between pulses
      END_STRUCT;
      STATUS { ExternalWritable := 'False'} : Struct
         state { ExternalWritable := 'False'} : Int := 1;   // STATE - 1=idle, 2=active
         active_state { ExternalWritable := 'False'} : Int := 1;   // STATE - 1=pulsing_1, 2 =waiting_1, 3=pulsing_2, 4=waiting_2
         active_sleeve { ExternalWritable := 'False'} : Int;   // STATE - Currently active sleeve (0=A, 1=B)
         is_idle { ExternalWritable := 'False'} : Bool;   // STATUS - Filter waiting for enable command
         is_active { ExternalWritable := 'False'} : Bool;   // STATUS - Filter cleaning routine active
         is_pulsing { ExternalWritable := 'False'} : Bool;   // STATUS - Filter currently pulsing
         is_waiting { ExternalWritable := 'False'} : Bool;   // STATUS - Filter waiting between pulses
         is_sleeve_A { ExternalWritable := 'False'} : Bool;   // STATUS - Sleeve A is being pulsed
         is_sleeve_B { ExternalWritable := 'False'} : Bool;   // STATUS - Sleeve B is being pulsed
      END_STRUCT;
   END_STRUCT;

END_TYPE

