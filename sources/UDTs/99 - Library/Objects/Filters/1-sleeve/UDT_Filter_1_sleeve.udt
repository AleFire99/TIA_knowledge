TYPE "UDT_Filter_1_sleeve"
VERSION : 0.1
   STRUCT
      DEVICES { ExternalWritable := 'False'} : Struct
         XY { ExternalWritable := 'False'; S7_SetPoint := 'False'} : "UDT_Solenoid_valve";   // OUTPUT - Solenoid command
      END_STRUCT;
      CMD : Struct
         manual_mode : Bool;   // COMMAND - Active mode
         manual : Bool;   // COMMAND - Manual command
         auto { ExternalWritable := 'False'} : Bool;   // COMMAND - Automatic command
         interlocked { ExternalWritable := 'False'} : Bool;   // COMMAND - 0=enabled/1=interlocked
      END_STRUCT;
      SETTING : Struct
         pulse_duration : Time := T#500ms;   // SETTING - Duration of active pulse
         interval_duration : Time := T#3s;   // SETTING - Duration of time between pulses
      END_STRUCT;
      STATUS { ExternalWritable := 'False'} : Struct
         state { ExternalWritable := 'False'} : Int := 1;   // STATE - 1=idle, 2=waiting, 3=active
         is_idle { ExternalWritable := 'False'} : Bool;   // STATUS - Filter is waiting for enable command
         is_waiting { ExternalWritable := 'False'} : Bool;   // STATUS - Filter is waiting for next pulse
         is_active { ExternalWritable := 'False'} : Bool;   // STATUS - Filter is being cleaned
      END_STRUCT;
   END_STRUCT;

END_TYPE

