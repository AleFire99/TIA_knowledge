TYPE "UDT_Pinch_Valve"
VERSION : 0.1
   STRUCT
      DEVICES { ExternalWritable := 'False'} : Struct
         PSL { ExternalWritable := 'False'} : Bool;   // INPUT - Pressure received (TRUE = closed)
         XY { ExternalWritable := 'False'; S7_SetPoint := 'False'} : "UDT_Solenoid_valve";   // OUTPUT - Command
      END_STRUCT;
      CMD : Struct
         manual_mode : Bool;   // COMMAND - Active mode
         manual : Bool;   // COMMAND - Manual command
         auto { ExternalWritable := 'False'} : Bool;   // COMMAND - Automatic command
         interlocked { ExternalWritable := 'False'} : Bool;   // COMMAND - 0=enabled/1=interlocked
         ack : Bool;   // COMMAND - Acknowledge all errors
      END_STRUCT;
      SETTING : Struct
         actuator_timeout : Time := T#2s;   // SETTING - Max time to complete movement
      END_STRUCT;
      STATUS { ExternalWritable := 'False'} : Struct
         state { ExternalWritable := 'False'} : Int := 1;   // STATE - 0=fault, 1=normal
         normal_state { ExternalWritable := 'False'} : Int := 1;   // STATE - 1=closed, 2=opening, 3=open, 4=closing
         is_fault { ExternalWritable := 'False'} : Bool;   // STATUS - Valve in fault state
         is_closed { ExternalWritable := 'False'} : Bool;   // STATUS - Valve closed
         is_opening { ExternalWritable := 'False'} : Bool;   // STATUS - Valve opening
         is_open { ExternalWritable := 'False'} : Bool;   // STATUS - Valve open
         is_closing { ExternalWritable := 'False'} : Bool;   // STATUS - Valve closing
      END_STRUCT;
      ALARMS { ExternalWritable := 'False'} : Struct
         error { ExternalWritable := 'False'} : Bool;   // ALARM - General error
      END_STRUCT;
   END_STRUCT;

END_TYPE

