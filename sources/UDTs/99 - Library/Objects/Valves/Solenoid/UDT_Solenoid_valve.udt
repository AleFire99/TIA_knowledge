TYPE "UDT_Solenoid_valve"
VERSION : 0.1
   STRUCT
      CMD : Struct
         manual_mode : Bool;   // COMMAND - Active mode
         manual : Bool;   // COMMAND - Manual command
         auto { ExternalWritable := 'False'} : Bool;   // COMMAND - Automatic command
         interlocked { ExternalWritable := 'False'} : Bool;   // COMMAND - 0=enabled/1=interlocked
      END_STRUCT;
      STATUS : Struct
         state { ExternalWritable := 'False'} : Int := 1;   // STATUS - 1=closed,3=active
         is_open { ExternalWritable := 'False'} : Bool;   // STATUS - Valve is open
         is_closed { ExternalWritable := 'False'} : Bool;   // STATUS - Valve is closed
      END_STRUCT;
      out : Bool;   // OUT - Solenoid valve command
   END_STRUCT;

END_TYPE

