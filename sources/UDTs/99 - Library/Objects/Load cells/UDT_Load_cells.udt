TYPE "UDT_Load_cells"
VERSION : 0.1
   STRUCT
      CMD : Struct
         ack : Bool;
         new_batch : Bool;
         bag_loaded : Bool;
         setpoint_confirm : Bool;
         setpoint : Real;
      END_STRUCT;
      IN { ExternalWritable := 'False'} : Struct
         current_weight { ExternalWritable := 'False'} : Real;
         weight_stable { ExternalWritable := 'False'} : Bool;
         scale_error { ExternalWritable := 'False'} : Bool;
         plant_start { ExternalWritable := 'False'} : Bool;
      END_STRUCT;
      OUT { ExternalWritable := 'False'} : Struct
         configured { ExternalWritable := 'False'} : Bool;
         tare_request { ExternalWritable := 'False'} : Bool;
      END_STRUCT;
      SETTING : Struct
         weight_min : Real := 10.0;
         weight_max : Real := 1000.0;
         tolerance : Real := 0.5;
         timeout_pt : Time;
      END_STRUCT;
      STATUS : Struct
         state : Int := 1;
         conveyed : Real;
         weight_at_start : Real;
      END_STRUCT;
      ALARMS { ExternalWritable := 'False'} : Struct
         incomplete { ExternalWritable := 'False'} : Bool;
         error { ExternalWritable := 'False'} : Bool;
      END_STRUCT;
   END_STRUCT;

END_TYPE

