TYPE "UDT_Nolvac"
VERSION : 0.1
   STRUCT
      DEVICES : Struct
         XV01 { S7_SetPoint := 'False'} : "UDT_SS_Valve";   // VALVE - Discharge valve
         XY02 { S7_SetPoint := 'False'} : "UDT_Solenoid_valve";   // VALVE - Cleaning valve
         XY03 { S7_SetPoint := 'False'} : "UDT_Solenoid_valve";   // VALVE - Venturi valve
      END_STRUCT;
      CMD : Struct
         manual_mode : Bool;   // COMMAND - Active mode
         auto { ExternalWritable := 'False'} : Bool;   // COMMAND - Automatic command
         interlocked { ExternalWritable := 'False'} : Bool;   // COMMAND - 0=enabled/1=interlocked
         ack : Bool;   // COMMAND - Acknowledge all errors and warnings
      END_STRUCT;
      SETTING : Struct
         suction_time : Time := T#30s;   // SETTING - Time Nolvac is aspiring material
         cleaning_time : Time := T#30S;   // SETTING - Time Nolvac cleaning state
      END_STRUCT;
      STATUS { ExternalWritable := 'False'} : Struct
         state { ExternalWritable := 'False'} : Int := 1;   // STATE - 0=error, 1=idle, 2=suction, 3=cleaning
         is_conveying { ExternalWritable := 'False'} : Bool;   // STATUS - Nolvac is conveying material
         is_cleaning { ExternalWritable := 'False'} : Bool;   // STATUS - Nolvac is purging material
      END_STRUCT;
      ALARMS { ExternalWritable := 'False'} : Struct
         valve_error { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;   // ALARM - Internal valve error
      END_STRUCT;
   END_STRUCT;

END_TYPE

