TYPE "UDT_Pinch_diverter"
VERSION : 0.1
   STRUCT
      DEVICES { ExternalWritable := 'False'} : Struct
         XVA { ExternalWritable := 'False'; S7_SetPoint := 'False'} : "UDT_Pinch_Valve";   // DEVICE - Pinch valve for line A
         XVB { ExternalWritable := 'False'; S7_SetPoint := 'False'} : "UDT_Pinch_Valve";   // DEVICE- Pinch valve for line B
      END_STRUCT;
      CMD : Struct
         manual_mode : Bool;   // COMMAND - Active mode
         manual : Bool;   // COMMAND - Manual command (TRUE = route B)
         auto { ExternalWritable := 'False'} : Bool;   // COMMAND - Automatic command (TRUE = route B)
         interlocked { ExternalWritable := 'False'} : Bool;   // COMMAND - 0=enabled/1=interlocked
         ack : Bool;   // COMMAND - Acknowledge all errors
      END_STRUCT;
      SETTING : Struct
         timeout_ms : Time := T#2s;   // SETTING - Sub-valve actuator timeout
      END_STRUCT;
      STATUS { ExternalWritable := 'False'} : Struct
         state { ExternalWritable := 'False'} : Int := 1;   // STATE - 0=error, 1=normal
         normal_state { ExternalWritable := 'False'} : Int := 1;   // STATE - 1=A active,2=A to B,3=B active,4=B to A
         is_fault { ExternalWritable := 'False'} : Bool;   // STATUS - Diverter in fault state
         is_in_A { ExternalWritable := 'False'} : Bool;   // STATUS - Routing through line A
         is_moving_to_B { ExternalWritable := 'False'} : Bool;   // STATUS - Transitioning to line B
         is_in_B { ExternalWritable := 'False'} : Bool;   // STATUS - Routing through line B
         is_moving_to_A { ExternalWritable := 'False'} : Bool;   // STATUS - Transitioning to line A
      END_STRUCT;
      ALARMS { ExternalWritable := 'False'} : Struct
         error { ExternalWritable := 'False'} : Bool;   // ALARM - General error
      END_STRUCT;
   END_STRUCT;

END_TYPE

