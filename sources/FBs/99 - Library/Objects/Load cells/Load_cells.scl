FUNCTION_BLOCK "Load_cells"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      batch : "UDT_Load_cells";
   END_VAR

   VAR 
      first_scan { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool := TRUE;
      weight_at_start { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Real;
      timeout_timer {InstructionName := 'TON_TIME'; LibVersion := '1.0'; ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : TON_TIME;
      ALARMS : Struct
         weight_out_of_range : Bool;
         setpoint_invalid : Bool;
         tare_rejected : Bool;
      END_STRUCT;
   END_VAR

   VAR CONSTANT 
      IDLE : Int := 1;
      TARING : Int := 2;
      WAIT_LOAD : Int := 3;
      SAVE_INITIAL : Int := 4;
      WAIT_SETPOINT : Int := 5;
      CONFIGURED : Int := 6;
      RUNNING : Int := 7;
      INCOMPLETE : Int := 8;
      ERROR : Int := 0;
   END_VAR


BEGIN
	REGION Initialization
	    IF #first_scan THEN
	        #first_scan := FALSE;
	        #batch.STATUS.state := #IDLE;
	        #weight_at_start := 0.0;
	    END_IF;
	END_REGION
	
	REGION Timeout timer
	    // Timer runs only in RUNNING state, preset comes from operator-configurable setting
	    #timeout_timer(IN := (#batch.STATUS.state = #RUNNING),
	                   PT := #batch.SETTING.timeout_pt);
	END_REGION
	
	REGION Alarm consolidation
	    // Consolidate hardware faults into single error flag
	    // scale_error covers: O-L signal, comms loss, overload, underload (all surfaced by FB_DAT1400)
	    #batch.ALARMS.error := #batch.IN.scale_error;
	    
	    // Ack clears incomplete latch, error latch is owned by FB_DAT1400
	    IF #batch.CMD.ack AND (#batch.STATUS.state = #INCOMPLETE) THEN
	        #batch.ALARMS.incomplete := FALSE;
	    END_IF;
	END_REGION
	
	REGION Diagnostic outputs
	    // Moore pattern asserted by state, cleared on all other states
	    // HMI reads these to display contextual operator hints
	    
	    #ALARMS.tare_rejected := (#batch.STATUS.state = #TARING)
	    AND NOT #batch.IN.weight_stable;
	    
	    #ALARMS.weight_out_of_range := (#batch.STATUS.state = #WAIT_LOAD)
	    AND (#batch.IN.current_weight < #batch.SETTING.weight_min
	    OR #batch.IN.current_weight > #batch.SETTING.weight_max);
	    
	    #ALARMS.setpoint_invalid := (#batch.STATUS.state = #WAIT_SETPOINT)
	    AND (#batch.CMD.setpoint <= 0.0
	    OR #batch.CMD.setpoint > #batch.IN.current_weight);
	END_REGION
	
	REGION FSM logic
	    CASE #batch.STATUS.state OF
	            
	        #IDLE:
	            IF #batch.ALARMS.error THEN
	                #batch.STATUS.state := #ERROR;
	            ELSIF #batch.CMD.new_batch THEN
	                #batch.STATUS.state := #TARING;
	            END_IF;
	            
	        #TARING:
	            IF #batch.ALARMS.error THEN
	                #batch.STATUS.state := #ERROR;
	            ELSIF #batch.IN.current_weight < #batch.SETTING.tolerance AND
	                #batch.IN.weight_stable THEN
	                // Scale accepted tare and net weight is now stable at zero
	                #batch.STATUS.state := #WAIT_LOAD;
	            END_IF;
	            
	        #WAIT_LOAD:
	            IF #batch.ALARMS.error THEN
	                #batch.STATUS.state := #ERROR;
	            ELSIF #batch.CMD.bag_loaded AND NOT #ALARMS.weight_out_of_range THEN
	                #batch.STATUS.state := #SAVE_INITIAL;
	            END_IF;
	            
	        #SAVE_INITIAL:
	            // Transient state, snapshot then advance immediately
	            IF #batch.ALARMS.error THEN
	                #batch.STATUS.state := #ERROR;
	            ELSE
	                #weight_at_start := #batch.IN.current_weight;
	                #batch.STATUS.weight_at_start := #weight_at_start;
	                #batch.STATUS.state := #WAIT_SETPOINT;
	            END_IF;
	            
	        #WAIT_SETPOINT:
	            IF #batch.ALARMS.error THEN
	                #batch.STATUS.state := #ERROR;
	            ELSIF #batch.CMD.setpoint_confirm AND NOT #ALARMS.setpoint_invalid THEN
	                #batch.STATUS.state := #CONFIGURED;
	            END_IF;
	            
	        #CONFIGURED:
	            IF #batch.ALARMS.error THEN
	                #batch.STATUS.state := #ERROR;
	            ELSIF #batch.IN.plant_start THEN
	                #batch.STATUS.state := #RUNNING;
	            END_IF;
	            
	        #RUNNING:
	            IF #batch.ALARMS.error THEN
	                #batch.STATUS.state := #ERROR;
	            ELSIF #timeout_timer.Q THEN
	                #batch.STATUS.state := #INCOMPLETE;
	            ELSIF #batch.STATUS.conveyed >= #batch.CMD.setpoint THEN
	                #batch.STATUS.state := #IDLE;
	            END_IF;
	            
	        #INCOMPLETE:
	            IF #batch.ALARMS.error THEN
	                #batch.STATUS.state := #ERROR;
	            ELSIF #batch.CMD.ack THEN
	                #batch.STATUS.state := #IDLE;
	            END_IF;
	            
	        #ERROR:
	            IF #batch.CMD.ack AND NOT #batch.ALARMS.error THEN
	                // Only allow ack if the underlying fault has cleared
	                #batch.STATUS.state := #IDLE;
	            END_IF;
	            
	    END_CASE;
	END_REGION
	
	REGION Conveyed quantity
	    // Computed every scan only meaningful in RUNNING state
	    // Clamped to zero to avoid negative display on drift
	    IF #batch.STATUS.state = #RUNNING THEN
	        #batch.STATUS.conveyed := #weight_at_start - #batch.IN.current_weight;
	        IF #batch.STATUS.conveyed < 0.0 THEN
	            #batch.STATUS.conveyed := 0.0;
	        END_IF;
	    ELSE
	        #batch.STATUS.conveyed := 0.0;
	    END_IF;
	END_REGION
	
	REGION Mapped outputs
	    // Moore outputs driven purely by state, not by transition conditions
	    
	    #batch.OUT.tare_request := FALSE;
	    #batch.OUT.configured := FALSE;
	    #batch.ALARMS.incomplete := FALSE;
	    #batch.ALARMS.error := FALSE;
	    
	    CASE #batch.STATUS.state OF
	        #TARING:
	            #batch.OUT.tare_request := TRUE;
	            
	        #CONFIGURED:
	            #batch.OUT.configured := TRUE;
	            
	        #INCOMPLETE:
	            #batch.ALARMS.incomplete := TRUE;
	            
	        #ERROR:
	            #batch.ALARMS.error := TRUE;
	            
	    END_CASE;
	END_REGION
	
END_FUNCTION_BLOCK

