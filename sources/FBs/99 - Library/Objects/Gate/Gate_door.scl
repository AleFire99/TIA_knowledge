FUNCTION_BLOCK "Gate_door"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      gate_door : "UDT_Gate_Door";
   END_VAR

   VAR 
      first_scan { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool := TRUE;
      fb_XY { ExternalWritable := 'False'; S7_SetPoint := 'False'} : "Solenoid_valve";
   END_VAR

   VAR CONSTANT 
      CLOSED_LOCKED : Int := 1;
      CLOSED_UNLOCKED : Int := 2;
      OPEN : Int := 3;
   END_VAR


BEGIN
	REGION Initialization
	    // On first scan, determine state from physical sensors
	    IF #first_scan THEN
	        #first_scan := FALSE;
	        IF #gate_door.DEVICES.ZSL THEN
	            #gate_door.STATUS.state := #CLOSED_LOCKED;
	        ELSE
	            #gate_door.STATUS.state := #OPEN;
	        END_IF;
	    END_IF;
	END_REGION
	
	REGION Map internal valves
	    #fb_XY(#gate_door.DEVICES.XY);
	END_REGION
	
	REGION FSM logic
	    // Moore machine: transitions driven by inputs, outputs assigned in Output mapping region
	    CASE #gate_door.STATUS.state OF
	            
	        #CLOSED_LOCKED:
	            IF #gate_door.CMD.open AND NOT #gate_door.CMD.interlocked THEN
	                // Guard is active-low: interlocked = FALSE means orchestrator permits opening
	                #gate_door.STATUS.state := #CLOSED_UNLOCKED;
	            END_IF;
	            
	        #CLOSED_UNLOCKED:
	            IF #gate_door.CMD.close THEN
	                // Operator re-lock while still closed
	                #gate_door.STATUS.state := #CLOSED_LOCKED;
	            ELSIF NOT #gate_door.DEVICES.ZSL THEN
	                // Operator has physically pushed the gate fully open
	                #gate_door.STATUS.state := #OPEN;
	            END_IF;
	            
	        #OPEN:
	            IF #gate_door.DEVICES.ZSL THEN
	                // Gate has been pushed back to closed position
	                #gate_door.STATUS.state := #CLOSED_LOCKED;
	            END_IF;
	            
	    END_CASE;
	END_REGION
	
	REGION Output mapping
	    #gate_door.DEVICES.XY.CMD.auto := FALSE;
	    #gate_door.STATUS.is_closed_locked := FALSE;
	    #gate_door.STATUS.is_closed_unlocked := FALSE;
	    #gate_door.STATUS.is_open := FALSE;
	    
	    CASE #gate_door.STATUS.state OF
	        #CLOSED_LOCKED:
	            #gate_door.DEVICES.XY.CMD.auto := TRUE;
	            #gate_door.STATUS.is_closed_locked := TRUE;
	            
	        #CLOSED_UNLOCKED:
	            #gate_door.STATUS.is_closed_unlocked := TRUE;
	            
	        #OPEN:
	            #gate_door.STATUS.is_open := TRUE;
	    END_CASE;
	END_REGION
END_FUNCTION_BLOCK

