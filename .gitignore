# TIA Portal internal dirs — AleFire-Library_V21 binary. Not git-tracked at all now: the
# .al21 itself is a Gitea release asset only (see CLAUDE.md "Gitea Release Process") — a
# binary this size doesn't belong in git history, and this repo's core.autocrlf + no
# .gitattributes combination risked silently corrupting it on commit/checkout anyway.
library/AleFire-Library_V21/AleFire-Library_V21.al21
library/AleFire-Library_V21/AleFire-Library_V21.info
library/AleFire-Library_V21/AdditionalFiles/
library/AleFire-Library_V21/IM/
library/AleFire-Library_V21/Logs/
library/AleFire-Library_V21/System/
library/AleFire-Library_V21/TMP/
library/AleFire-Library_V21/tmp/
library/AleFire-Library_V21/UserFiles/
library/AleFire-Library_V21/Vci/
library/AleFire-Library_V21/XRef/
library/AleFire-Library_V21/src/
library/AleFire-Library_V21/*.backup/

# siemens_tia_scripting local CLI state
.tia/

# Ingest hash cache (local build artifact — not portable across machines)
dist/.ingest_cache.json

# Claude local settings
.claude/settings.local.json
